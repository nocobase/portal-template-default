# Values in .env.server.* are read by the Portal server and dev/build scripts.
# Server-only targets are not embedded into window.__NOCOBASE_PORTAL_ENV__ and
# file values are not registered onto process.env.

# Server-side Portal identity.
NOCOBASE_PORTAL_NAME=main

# Real NocoBase REST API target used by the Portal server proxy.
# Main app:
NOCOBASE_API_PROXY_TARGET=http://127.0.0.1:64074/api
# Sub-app example:
# NOCOBASE_API_PROXY_TARGET=http://127.0.0.1:64074/api/__app/subapp1

# Optional server-side overrides.
# NOCOBASE_APP_NAME=subapp1
# NOCOBASE_WS_PROXY_TARGET=ws://127.0.0.1:64074/ws?__appName=subapp1
# PORTAL_BASE_PATH=/apps/subapp1/portals/main
# PORTAL_LOG_LEVEL=info
# APP_PORT=13000
