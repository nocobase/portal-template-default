# Only these browser-safe API client storage settings are read from .env.client.*.
#
# Portal identity, API URL, Portal base, WebSocket URL, and authenticator are
# generated automatically during dev/build and injected into
# window.__NOCOBASE_PORTAL_ENV__.
# API_CLIENT_STORAGE_PREFIX=NOCOBASE_
# API_CLIENT_STORAGE_TYPE=localStorage
# API_CLIENT_SHARE_TOKEN=false
