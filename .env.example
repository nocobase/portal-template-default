# NocoBase REST API root (the /api suffix is required)
NOCOBASE_API_URL=/api

# Koa BFF development server. Vite proxies /api and /_app/api to this origin.
APP_SERVER_URL=http://localhost:3000
APP_SERVER_HOST=0.0.0.0
APP_SERVER_PORT=3000

# Real NocoBase REST API target used by the Koa /api proxy.
# NOCOBASE_API_PROXY_TARGET=https://example.com/api

# Public base path for Vite assets and React Router when deployed under NocoBase.
# Use / for root-local development, or /x/admin/ when building for storage/dist-client/x/admin.
NOCOBASE_PORTAL_BASE=/x/admin/

# Keep these aligned with the main NocoBase frontend when customized.
# API_CLIENT_STORAGE_PREFIX=NOCOBASE_
# API_CLIENT_STORAGE_TYPE=localStorage
# API_CLIENT_SHARE_TOKEN=false
